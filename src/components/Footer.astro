---
import { SITE } from '../config';
---

<footer class="footer">
  <p class="footer__copy">{SITE.name} &copy; 2026</p>
</footer>

<style>
  .footer {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    min-height: var(--footer-height);
    padding: 0.75rem clamp(1.25rem, 5vw, 3rem);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--faint);
  }

  .footer::before,
  .footer::after {
    content: '';
    position: absolute;
    top: -4px;
    width: 7px;
    height: 7px;
    border: 1px solid var(--border-strong);
    background: var(--bg);
  }

  .footer::before {
    left: -4px;
  }

  .footer::after {
    right: -4px;
  }

  .footer__copy {
    margin: 0;
  }

  @media (max-width: 30em) {
    .footer {
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
