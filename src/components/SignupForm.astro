<form class="signup" novalidate data-signup>
  <div class="signup__row">
    <label class="sr-only" for="signup-email">Email address</label>
    <input
      class="signup__input"
      id="signup-email"
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      autocapitalize="off"
      spellcheck="false"
      maxlength="254"
      placeholder="you@example.com"
      required
    />
    <div class="signup__action">
      <button
        class="signup__button"
        type="button"
        aria-disabled="true"
        aria-describedby="signup-tooltip"
      >
        Notify me at launch
      </button>
      <span class="signup__tooltip" id="signup-tooltip" role="tooltip">
        Signups are currently disabled. Try again later.
      </span>
    </div>
  </div>
</form>

<style>
  .signup {
    width: 100%;
    max-width: 30rem;
  }

  .signup__row {
    display: flex;
    gap: 0.5rem;
  }

  .signup__input {
    flex: 1 1 auto;
    min-width: 0;
    height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--bg);
    color: var(--white);
    font-size: 0.9375rem;
    transition: border-color 0.15s ease;
  }

  .signup__input::placeholder {
    color: var(--faint);
    opacity: 1;
  }

  .signup__input:hover {
    border-color: #3a3a44;
  }

  .signup__input:focus {
    outline: none;
  }

  .signup__input:focus-visible {
    border-color: var(--silver);
    outline: none;
  }

  .signup__input[aria-invalid='true'] {
    border-color: var(--silver);
  }

  .signup__button {
    flex: 0 0 auto;
    height: 2.75rem;
    padding: 0 1.25rem;
    border: 1px solid var(--silver);
    border-radius: 6px;
    background: var(--silver);
    color: var(--bg);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  .signup__button:hover {
    background: var(--white);
    border-color: var(--white);
  }

  .signup__button:disabled {
    cursor: progress;
    opacity: 0.6;
  }

  .signup__action {
    position: relative;
    flex: 0 0 auto;
  }

  .signup__button[aria-disabled='true'] {
    border-color: var(--border-strong);
    background: var(--border);
    color: var(--faint);
    cursor: not-allowed;
  }

  .signup__button[aria-disabled='true']:hover,
  .signup__button[aria-disabled='true']:focus-visible {
    border-color: #3a3a44;
    background: #1e1e25;
    color: var(--muted);
  }

  .signup__tooltip {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 10;
    width: max-content;
    max-width: min(22rem, calc(100vw - 4rem));
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #141418;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -2px rgba(0, 0, 0, 0.1);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: left;
    color: var(--silver);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px) scale(0.96);
    transform-origin: top right;
    transition:
      opacity 0.1s ease-in,
      transform 0.1s ease-in,
      visibility 0s linear 0.1s;
  }

  .signup__action:hover .signup__tooltip,
  .signup__action[data-open] .signup__tooltip,
  .signup__button:focus-visible + .signup__tooltip {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.15s var(--ease-out) 0.1s,
      transform 0.15s var(--ease-out) 0.1s,
      visibility 0s linear 0.1s;
  }

  .signup__action[data-dismissed] .signup__tooltip {
    opacity: 0;
    visibility: hidden;
  }

  @media (max-width: 27.5em) {
    .signup__row {
      flex-direction: column;
    }

    .signup__action,
    .signup__button {
      width: 100%;
    }

    .signup__tooltip {
      left: 0;
      margin-inline: auto;
      text-align: center;
      transform-origin: top center;
    }
  }
</style>

<script>
  function initDisabled(form: HTMLFormElement) {
    const action = form.querySelector<HTMLElement>('.signup__action');
    const button = action?.querySelector<HTMLButtonElement>('button');
    if (!action || !button) return;

    let timer = 0;
    const flash = (event: Event) => {
      event.preventDefault();
      action.removeAttribute('data-dismissed');
      action.setAttribute('data-open', '');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => action.removeAttribute('data-open'), 2500);
    };
    form.addEventListener('submit', flash);
    form.querySelector('input[name="email"]')?.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Enter') flash(event);
    });

    const restore = () => action.removeAttribute('data-dismissed');
    action.addEventListener('mouseleave', restore);
    button.addEventListener('blur', restore);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') action.setAttribute('data-dismissed', '');
    });
  }

  document.querySelectorAll<HTMLFormElement>('form[data-signup]').forEach(initDisabled);
</script>
