---
import logo from '../../public/logo_transbg.png';
import { SITE } from '../config';
---

<header class="hero">
  <img
    class="hero__logo"
    src={logo.src}
    width={logo.width}
    height={logo.height}
    alt=""
    decoding="async"
    fetchpriority="high"
  />
  <h1 class="hero__wordmark">{SITE.name}</h1>
  <p class="hero__tagline">{SITE.tagline}</p>
</header>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__logo {
    width: clamp(96px, 24vw, 132px);
    height: auto;
    aspect-ratio: 1 / 0.66;
    object-fit: cover;
    object-position: 50% 33%;
  }

  .hero__wordmark {
    margin: clamp(1.5rem, 4.5vw, 2rem) 0 0;
    padding-left: 0.4em;
    font-size: clamp(1.5rem, 6vw, 2.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--white);
  }

  .hero__tagline {
    max-width: 26ch;
    margin: clamp(1.125rem, 3.5vw, 1.375rem) 0 0;
    font-size: clamp(1.125rem, 3.6vw, 1.5rem);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--silver);
    text-wrap: balance;
  }
</style>
